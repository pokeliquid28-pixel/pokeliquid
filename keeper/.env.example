# ─── eBay Browse API ─────────────────────────────────────────────────────────
# Production credentials from the eBay developer portal.
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# ─── Solana ───────────────────────────────────────────────────────────────────
ADMIN_KEYPAIR_PATH=/Users/ethangriffin/.config/solana/id.json
RPC_URL=https://api.devnet.solana.com

# ─── Program addresses ───────────────────────────────────────────────────────
PROGRAM_ID=7DVf9oEMcKPV6VUUz5BpptbwqpgBfXunwxjTNNQmZvbJ
ORACLE_PUBKEY=2euE9eMGTNwyW7jqG63JvRZfHeo7psKZgBCizfNMjW12
PROTOCOL_STATE_PUBKEY=8cGem2Q8BrqYpvnwqscnGiKjoEZPXpyb8KziueJ24SiK

# ─── Keeper settings ─────────────────────────────────────────────────────────
# How often to push a new price (milliseconds). Default: 5 minutes.
UPDATE_INTERVAL_MS=300000

# Warn if new price deviates more than this fraction from the last accepted price.
MAX_DEVIATION_WARN=0.25

# Reject and use last good price if deviation exceeds this fraction.
MAX_DEVIATION_REJECT=0.50

# Hard range for Unlimited Base Set Charizard PSA 10 (USD).
# Prices outside this window are treated as bad API data and rejected.
PRICE_MIN_USD=500
PRICE_MAX_USD=10000

# Bootstrap price (USD) used as the deviation baseline on first run,
# before the first valid eBay price is accepted.
SEED_PRICE_USD=2230

# ─── Secondary keypair (fallback oracle pusher) ─────────────────────────────
SECONDARY_KEYPAIR_PATH=./secondary.json

# ─── Telegram alerts ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
